DATABASE_URL="postgresql://postgres@127.0.0.1:55432/wecraft_dt?schema=public"
# Reserved for future signed-session extensions; current sessions use random opaque tokens.
SESSION_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://127.0.0.1:3000"
STORAGE_DRIVER="local"
STORAGE_ROOT="./storage"
# Leave Feishu values empty to use email login and in-app notifications only.
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_REDIRECT_URI=""
# Optional: point to an installed Chrome/Chromium when Playwright browser binaries are unavailable.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=""
# Set true behind HTTPS.
COOKIE_SECURE="false"
# Optional production bootstrap values. Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_WORKSPACE_NAME=""
BOOTSTRAP_WORKSPACE_SLUG=""
